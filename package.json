{
  "name": "gha-management",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:create": "wrangler d1 create gha-management-db",
    "db:migrate:local": "wrangler d1 migrations apply gha-management-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply gha-management-db --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^6.1.0",
    "@prisma/client": "^6.1.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "hono": "^4.12.27",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.21",
    "prisma": "^6.1.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.105.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.17.19": true,
    "workerd@1.20250718.0": true,
    "sharp@0.33.5": true
  }
}
