{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gha-management",
	"main": "src/worker.ts",
	"compatibility_date": "2025-05-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gha-management-db",
			"database_id": "07b8049c-8bf7-426e-bb75-bad2f47a8cb1",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true
	}
	// Secrets (set via `wrangler secret put`):
	//   GEMINI_API_KEY
}